# Copy to .env.local and fill in. Never commit real values.

# Base URL of the 48Date API, including the version prefix (Postman environment `baseUrl`).
# Leave empty to run on the built-in mocks. The backend's default port (3000) is the same as
# `next dev`, so run one of them on another port, e.g. API on 4000:
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_BASE_URL=

# Optional: Socket.IO gateway (Postman `socketUrl`). Defaults to the origin of the API base URL.
NEXT_PUBLIC_SOCKET_URL=

# Optional: WebSocket origin (Postman `wsUrl`), allowed by the Content-Security-Policy. Defaults to
# the socket URL with ws:// / wss://.
NEXT_PUBLIC_WS_URL=

# Keys issued by the backend for the web client and the socket. NEXT_PUBLIC_ values are built into
# the browser code and visible to everyone: public client identifiers only, never secrets.
NEXT_PUBLIC_WEB_KEY=
NEXT_PUBLIC_SOCKET_KEY=

# Optional: where photo keys are served from when the API returns a storage key rather than a
# signed URL (e.g. https://media.example.com). Absolute photo URLs are used as they are.
NEXT_PUBLIC_MEDIA_BASE_URL=

# Optional: Google OAuth web client ID for "Continue with Google" and account linking. It must
# also be listed in the backend's GOOGLE_CLIENT_IDS. Empty keeps the Google buttons disabled.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: version sent as `device.appVersion` on sign-in.
NEXT_PUBLIC_APP_VERSION=
